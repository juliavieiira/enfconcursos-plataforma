# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - ENFCONCURSOS (SUPABASE & GATEWAY)
# ==============================================================================
# Para conectar ao seu projeto oficial do Supabase:
# 1. Acesse https://app.supabase.com e crie um novo projeto gratuito.
# 2. Copie a URL do Projeto e a Chave Anon (pública) em Project Settings > API.
# 3. Preencha as duas variáveis abaixo e renomeie este arquivo para .env.local

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# GATEWAYS DE PAGAMENTO (Próxima etapa: Asaas / Mercado Pago / Stripe)
# VITE_PAYMENT_GATEWAY=asaas
# VITE_ASAAS_URL=https://api.asaas.com/v3
